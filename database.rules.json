{
  "rules": {
    ".read": false,
    ".write": false,
    "calendar": {
      "events": {
        ".read": true,
        "$id": {
          ".write": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.uid).val() == true || root.child('members').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['title','start','end','color','desc','rev','updatedBy','updatedAt']) && newData.child('end').val() >= newData.child('start').val()",
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "start": {
            ".validate": "newData.isString() && newData.val().matches(/^(2026-(11-(0[1-9]|[12][0-9]|30)|12-(0[1-9]|[12][0-9]|3[01]))|2027-((01|03|05|07|08)-(0[1-9]|[12][0-9]|3[01])|02-(0[1-9]|1[0-9]|2[0-8])|(04|06|09)-(0[1-9]|[12][0-9]|30)))$/)"
          },
          "end": {
            ".validate": "newData.isString() && newData.val().matches(/^(2026-(11-(0[1-9]|[12][0-9]|30)|12-(0[1-9]|[12][0-9]|3[01]))|2027-((01|03|05|07|08)-(0[1-9]|[12][0-9]|3[01])|02-(0[1-9]|1[0-9]|2[0-8])|(04|06|09)-(0[1-9]|[12][0-9]|30)))$/)"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^(sage|dustypink|slate|clay|sand|lavender|olive|taupe|denim|plum)$/)"
          },
          "desc": {
            ".validate": "newData.isString() && newData.val().length <= 3000"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
          },
          "rev": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "tasks": {
        ".read": true,
        "$group": {
          "$id": {
            ".write": "$group.matches(/^(host|marketing|engineering)$/) && auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.uid).val() == true || root.child('members').child(auth.uid).exists()) && newData.exists()",
            ".validate": "newData.hasChildren(['title','done'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "monthlyTasks": {
        "$month": {
          ".read": "$month.matches(/^(2026-12|2027-0[1-9])$/)",
          "$group": {
            "$id": {
              ".write": "$month.matches(/^(2026-12|2027-0[1-9])$/) && $group.matches(/^(host|marketing|engineering)$/) && auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.uid).val() == true || root.child('members').child(auth.uid).exists()) && newData.exists()",
              ".validate": "newData.hasChildren(['title','done'])",
              "title": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160"
              },
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "notes": {
        ".read": true,
        "$month": {
          ".write": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.uid).val() == true || root.child('members').child(auth.uid).exists())",
          ".validate": "$month.matches(/^(2026-(11|12)|2027-0[1-9])$/) && newData.hasChildren(['text','rev','updatedBy','updatedAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 10000"
          },
          "rev": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "members": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.uid).val() == true",
        ".validate": "newData.hasChildren(['email','name'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "requests": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "(auth != null && auth.token.email_verified == true && root.child('admins').child(auth.uid).val() == true) || (auth != null && auth.uid == $uid && auth.token.email_verified == true && !data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['email','name']) && newData.child('email').val() == auth.token.email",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.uid).val() == true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    }
  }
}
